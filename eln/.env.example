# ELN – Konfiguration
# Kopieren Sie diese Datei nach ".env" und passen Sie die Werte an.
# Pfade dürfen absolut (empfohlen, z. B. C:\ELN-Daten) oder relativ zum Programmordner sein.

# Datenverzeichnis (Datenbank, Dateiablage, Protokolle)
ELN_DATA_DIR=data

# Optional: eigene Datenbank-URL (Standard: SQLite im Datenverzeichnis)
# ELN_DATABASE_URL=sqlite:///C:/ELN-Daten/eln.db

# Optional: eigener Ablageort für Dateien (Standard: <ELN_DATA_DIR>/files)
# ELN_FILES_DIR=C:/ELN-Daten/files

# Sicherungsziel – möglichst außerhalb des Datenverzeichnisses, z. B. anderes Laufwerk
ELN_BACKUP_DIR=backups

# Netzwerk – 127.0.0.1 = nur lokal erreichbar
ELN_HOST=127.0.0.1
ELN_PORT=8000

# Sitzungsablauf bei Inaktivität (Minuten)
ELN_SESSION_TIMEOUT_MIN=60

# Maximale Uploadgröße pro Datei (MB)
ELN_MAX_UPLOAD_MB=100

# Sperre nach fehlgeschlagenen Anmeldungen
ELN_MAX_FAILED_LOGINS=5
ELN_LOCKOUT_MINUTES=15

# Cookies nur über HTTPS senden (bei Betrieb hinter HTTPS-Reverse-Proxy auf 1 setzen)
ELN_COOKIE_SECURE=0

# Protokollierungsstufe: DEBUG, INFO, WARNING, ERROR
ELN_LOG_LEVEL=INFO

# Browser beim Start automatisch öffnen (1/0)
ELN_OPEN_BROWSER=1
